                  "color": "yellow"
                },
                "2": {
                  "index": 3,
                  "text": "CRÍTICO",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-gray",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "airflow-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH classificadas AS (\n  SELECT d.dag_id\n  FROM dag d\n  WHERE d.is_stale = FALSE\n    AND d.is_paused = FALSE\n    AND (NOT (\n  d.owners ILIKE '%integr%'\n  OR EXISTS (\n    SELECT 1 FROM dag_tag dt\n    WHERE dt.dag_id = d.dag_id AND dt.name ILIKE '%integr%'\n  )\n))\n), ultima_execucao AS (\n  SELECT DISTINCT ON (dr.dag_id) dr.dag_id, dr.state\n  FROM dag_run dr\n  JOIN classificadas c ON c.dag_id = dr.dag_id\n  ORDER BY dr.dag_id, COALESCE(dr.logical_date, dr.created_at) DESC\n), indicadores AS (\n  SELECT\n    (SELECT COUNT(*) FROM classificadas) AS dags,\n    (SELECT COUNT(*) FROM ultima_execucao WHERE state = 'failed') AS falhas,\n    (SELECT COUNT(*) FROM task_instance ti JOIN classificadas c ON c.dag_id = ti.dag_id\n      WHERE ti.state = 'queued' AND COALESCE(ti.queued_dttm, ti.scheduled_dttm) < NOW() - INTERVAL '10 minutes') AS fila_atrasada,\n    (SELECT COUNT(*) FROM task_instance ti JOIN classificadas c ON c.dag_id = ti.dag_id\n      WHERE ti.state = 'running' AND ti.start_date < NOW() - INTERVAL '2 hours') AS execucoes_longas\n)\nSELECT CASE\n  WHEN dags = 0 THEN -1\n  WHEN fila_atrasada > 0 OR falhas >= 5 THEN 2\n  WHEN falhas > 0 OR execucoes_longas > 0 THEN 1\n  ELSE 0\nEND AS status\nFROM indicadores",
          "refId": "A"
        }
      ],
      "description": "Considera apenas DAGs ativas; falhas recentes, fila acima de 10 min e execuções acima de 2 h."
    },
