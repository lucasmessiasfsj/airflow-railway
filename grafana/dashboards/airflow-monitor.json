          "rawSql": "SELECT d.dag_id AS \"DAG\", d.owners AS \"Responsável\", d.is_paused AS \"Pausada\", d.timetable_summary AS \"Schedule\", r.state AS \"Estado\", r.start_date AS \"Início\", r.end_date AS \"Fim\", ROUND(EXTRACT(EPOCH FROM (COALESCE(r.end_date, NOW()) - r.start_date))::NUMERIC / 60, 2) AS \"Duração (min)\", d.next_dagrun AS \"Próxima execução\" FROM dag d LEFT JOIN LATERAL (SELECT state, start_date, end_date FROM dag_run dr WHERE dr.dag_id = d.dag_id ORDER BY COALESCE(dr.logical_date, dr.created_at) DESC LIMIT 1) r ON TRUE WHERE d.is_stale = FALSE ORDER BY CASE r.state WHEN 'failed' THEN 0 WHEN 'running' THEN 1 ELSE 2 END, r.start_date DESC NULLS LAST LIMIT 250",
