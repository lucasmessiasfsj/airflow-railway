      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sp.pool AS \"Pool\", sp.slots AS \"Capacidade\", COALESCE(SUM(ti.pool_slots) FILTER (WHERE ti.state = 'running'), 0) AS \"Em uso\", COALESCE(SUM(ti.pool_slots) FILTER (WHERE ti.state = 'queued'), 0) AS \"Fila\", COALESCE(SUM(ti.pool_slots) FILTER (WHERE ti.state = 'deferred'), 0) AS \"Deferred\" FROM slot_pool sp LEFT JOIN task_instance ti ON ti.pool = sp.pool GROUP BY sp.pool, sp.slots ORDER BY sp.pool",
          "refId": "A"
