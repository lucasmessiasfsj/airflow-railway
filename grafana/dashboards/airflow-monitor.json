          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ultima AS (SELECT DISTINCT ON (dag_id) dag_id, state FROM dag_run ORDER BY dag_id, COALESCE(logical_date, created_at) DESC), tags AS (SELECT d.dag_id, COALESCE(NULLIF(STRING_AGG(DISTINCT dt.name, ', '), ''), 'sem tag') AS tag, COALESCE(d.owners, 'sem responsável') AS responsavel FROM dag d LEFT JOIN dag_tag dt ON dt.dag_id = d.dag_id WHERE d.is_stale = FALSE GROUP BY d.dag_id, d.owners) SELECT t.tag AS \"Tag\", t.responsavel AS \"Responsável\", COUNT(*) FILTER (WHERE u.state = 'failed') AS \"Com falha\", COUNT(*) FILTER (WHERE u.state = 'running') AS \"Executando\", COUNT(*) AS \"DAGs\" FROM tags t LEFT JOIN ultima u ON u.dag_id = t.dag_id GROUP BY t.tag, t.responsavel HAVING COUNT(*) FILTER (WHERE u.state IN ('failed','running')) > 0 ORDER BY \"Com falha\" DESC, \"Executando\" DESC, t.tag LIMIT 50",
          "refId": "A"
        }
