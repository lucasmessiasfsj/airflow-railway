          "rawQuery": true,
          "rawSql": "SELECT DATE_TRUNC('hour', COALESCE(start_date, queued_at, created_at)) AS time, COUNT(*) FILTER (WHERE state = 'success') AS success, COUNT(*) FILTER (WHERE state = 'failed') AS failed, COUNT(*) FILTER (WHERE state = 'running') AS running, COUNT(*) FILTER (WHERE state = 'queued') AS queued FROM dag_run WHERE COALESCE(start_date, queued_at, created_at) >= NOW() - INTERVAL '24 hours' GROUP BY 1 ORDER BY 1",
