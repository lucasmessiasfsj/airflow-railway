      },
      "transparent": false,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "airflow-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
